{
    "info": {
        "_postman_id": "productivity-api-simple",
        "name": "Productivity App API (Simple)",
        "description": "Simple skeleton collection with no scripts or variables.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": "http://localhost:8000/api/v1/auth/register"
                    },
                    "response": []
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": "http://localhost:8000/api/v1/auth/login"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Tasks",
            "item": [
                {
                    "name": "Create Task",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Sample Task\",\n    \"description\": \"This is a sample task description.\",\n    \"priority\": \"Medium\",\n    \"deadline\": \"2024-12-31T23:59:59\",\n    \"tags\": \"sample,test\"\n}"
                        },
                        "url": "http://localhost:8000/api/v1/task/create"
                    },
                    "response": []
                },
                {
                    "name": "Fetch All Tasks",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            }
                        ],
                        "url": "http://localhost:8000/api/v1/task/fetch"
                    },
                    "response": []
                },
                {
                    "name": "Fetch Single Task",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            }
                        ],
                        "url": "http://localhost:8000/api/v1/task/fetch/1"
                    },
                    "response": []
                },
                {
                    "name": "Update Task",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"status\": \"Completed\"\n}"
                        },
                        "url": "http://localhost:8000/api/v1/task/update/1"
                    },
                    "response": []
                },
                {
                    "name": "Delete Task",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            }
                        ],
                        "url": "http://localhost:8000/api/v1/task/delete/1"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Stats",
            "item": [
                {
                    "name": "Get Stats",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            }
                        ],
                        "url": "http://localhost:8000/api/v1/stats/"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Admin",
            "item": [
                {
                    "name": "Get All Users",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            }
                        ],
                        "url": "http://localhost:8000/api/v1/admin/users"
                    },
                    "response": []
                },
                {
                    "name": "Get Users With Tasks",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            }
                        ],
                        "url": "http://localhost:8000/api/v1/admin/users-tasks"
                    },
                    "response": []
                },
                {
                    "name": "Update User Role",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer YOUR_ACCESS_TOKEN_HERE"
                            },
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"role\": \"admin\"\n}"
                        },
                        "url": "http://localhost:8000/api/v1/admin/users/user@example.com/role"
                    },
                    "response": []
                }
            ]
        }
    ]
}